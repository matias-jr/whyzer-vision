# Supabase — used by /newsletter/:slug (public read) and /admin/* (auth + write)
# Get these from Supabase Project Settings → API
# anon key is safe to ship in the client bundle; service_role key is NEVER committed and never read by the browser
VITE_SUPABASE_URL=
VITE_SUPABASE_ANON_KEY=

# LinkedIn Conversions API (server-side). Token is a 60-day token from Campaign Manager.
LINKEDIN_ACCESS_TOKEN=
LINKEDIN_NEWSLETTER_CONVERSION_ID=
LINKEDIN_WEBINAR_CONVERSION_ID=
# Event 1: Checkout started (click to subscribe.whyzer.ai)
LINKEDIN_CHECKOUT_CONVERSION_ID=
# Event 2: Trial subscribed, reported by a GHL workflow webhook to /api/track-purchase
LINKEDIN_TRIAL_CONVERSION_ID=
# Shared secret the GHL webhook sends in the x-webhook-secret header
TRACK_PURCHASE_SECRET=

# Black Friday 2026 private list (/black-friday). Needs its own GHL Private Integration token with
# contacts.write + contacts.readonly (the reporting GHL_TOKEN is read-only). Uses GHL_LOCATION_ID too.
GHL_BF26_TOKEN=
# Tag added to every sign-up; the Nov 25 workflow and the public seller counter both key off it.
BF26_TAG=bf26-waitlist
# Optional: people who joined before the tag existed, added to the public count.
BF26_COUNT_OFFSET=0
